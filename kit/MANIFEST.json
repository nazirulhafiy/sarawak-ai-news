{
  "version": 1,
  "files": [
    "MANIFEST.json",
    "README.md",
    "sync.py",
    "__init__.py",
    "shell.py",
    "analytics_registry.py",
    "analytics_loader.py",
    "assets/icons/nav-mark-transparent.svg",
    "assets/icons/nav-mark-transparent-dark.svg",
    "css/back-to-top.css",
    "js/back-to-top.js"
  ],
  "invariants": [
    {
      "id": "footer-contact",
      "path": "shell.py",
      "must_contain": "mailto:contact@sarawak.news"
    },
    {
      "id": "back-to-top-attr",
      "path": "shell.py",
      "must_contain": "data-back-to-top"
    },
    {
      "id": "back-to-top-label",
      "path": "shell.py",
      "must_contain": "back-to-top-label"
    },
    {
      "id": "back-to-top-arrow",
      "path": "shell.py",
      "must_contain": "back-to-top-arrow"
    },
    {
      "id": "analytics-loader-attr",
      "path": "analytics_loader.py",
      "must_contain": "data-sn-analytics-loader"
    },
    {
      "id": "analytics-internal-param",
      "path": "analytics_loader.py",
      "must_contain": "traffic_type"
    },
    {
      "id": "btt-css-class",
      "path": "css/back-to-top.css",
      "must_contain": ".back-to-top"
    },
    {
      "id": "btt-js-selector",
      "path": "js/back-to-top.js",
      "must_contain": "[data-back-to-top]"
    }
  ],
  "hub_consumers": {
    "icons": {
      "kit": "assets/icons/nav-mark-transparent.svg",
      "site": "site/icons/nav-mark-transparent.svg"
    },
    "icons_dark": {
      "kit": "assets/icons/nav-mark-transparent-dark.svg",
      "site": "site/icons/nav-mark-transparent-dark.svg"
    },
    "btt_css": {
      "kit": "css/back-to-top.css",
      "site": "site/style.css",
      "marker": "sn-kit:back-to-top"
    },
    "btt_js": {
      "kit": "js/back-to-top.js",
      "site": "site/app.js",
      "marker": "sn-kit:back-to-top"
    }
  }
}
